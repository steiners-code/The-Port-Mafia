generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["main"]
}

model UserProfile {
  userId    String  @id
  firstName String
  lastName  String?
  email     String

  connectedApps ConnectedApps[]
  mainTasks     MainTask[]
  mainJournal   MainJournal[]
  mainChat      MainChat?

  updatedAt DateTime @updatedAt

  @@schema("main")
}

model Session {
  id String @id @default(uuid())

  userId    String
  userAgent String?
  ipAddress String?
  isRevoked Boolean @default(false)

  tokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("main")
}

model RefreshToken {
  id String @id @default(uuid())

  hash      String  @unique
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  isUsed    Boolean @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@schema("main")
}

model ConnectedApps {
  id String @id @default(uuid())

  userId String
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  app    AppType
  status AppStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, app])
  @@schema("main")
}

enum AppType {
  HOME
  LINKEDIN
  X
  REDDIT
  FACEBOOK
  INSTAGRAM
  THREADS
  TIKTOK

  @@schema("main")
}

enum AppStatus {
  CONNECTED
  DISCONNECTED

  @@schema("main")
}

enum MainTriggerType {
  SYSTEM
  CRON
  USER

  @@schema("main")
}

enum MainMessageStatus {
  QUEUED
  PENDING
  SUCCESS
  FAILED

  @@schema("main")
}

enum MainContentType {
  TEXT
  TOOL
  MEDIA
  THOUGHT

  @@schema("main")
}

enum MainContentStatus {
  PENDING
  COMPLETED
  FAILED

  @@schema("main")
}

enum MainLogLevel {
  INFO
  SUCCESS
  ERROR

  @@schema("main")
}

model MainChat {
  id String @id @default(cuid())

  userId String      @unique
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  messages MainChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("main")
}

model MainChatMessage {
  id     String   @id @default(cuid())
  chatId String
  chat   MainChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  triggerType MainTriggerType
  status      MainMessageStatus @default(QUEUED)

  contents MainMessageContent[]

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@schema("main")
}

model MainMessageContent {
  id            String          @id @default(cuid())
  chatMessageId String
  chatMessage   MainChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  sequence    Int
  contentType MainContentType
  status      MainContentStatus @default(PENDING)

  message String?
  output  Json?

  logs MainLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatMessageId, sequence, createdAt])
  @@schema("main")
}

model MainLog {
  id        String             @id @default(cuid())
  contentId String
  content   MainMessageContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  level   MainLogLevel
  message String

  createdAt DateTime @default(now())

  @@index([contentId, createdAt])
  @@schema("main")
}

enum MainFileType {
  USER
  MEMORY

  @@schema("main")
}

model MainFile {
  id       String       @id @default(cuid())
  userId   String
  fileType MainFileType
  content  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fileType])
  @@schema("main")
}

model MainJournal {
  id     String      @id @default(cuid())
  userId String
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  date     DateTime
  contents MainJournalContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@schema("main")
}

model MainJournalContent {
  id String @id @default(cuid())

  content String

  journalId   String
  mainJournal MainJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  tags MainJournalTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("main")
}

model MainJournalTag {
  tagId String
  tag   MainTag @relation(fields: [tagId], references: [id])

  journalContentId String
  journalContent   MainJournalContent @relation(fields: [journalContentId], references: [id])

  createdAt DateTime @default(now())

  @@id([tagId, journalContentId])
  @@schema("main")
}

model MainTag {
  id String @id @default(nanoid())

  slug        String  @unique
  description String?

  journalTags MainJournalTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("main")
}

enum SubAgent {
  MAHA

  @@schema("main")
}

enum MainTaskStatus {
  PENDING
  INPROGRESS
  COMPLETED
  CANCELLED

  @@schema("main")
}

enum MainTaskLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW

  @@schema("main")
}

model MainTask {
  id     String      @id @default(cuid())
  userId String
  user   UserProfile @relation(fields: [userId], references: [userId])

  title   String
  content Json

  level    MainTaskLevel  @default(MEDIUM)
  status   MainTaskStatus @default(PENDING)
  progress Int            @default(0)

  comments MainTaskComment[]

  subAgent         SubAgent
  subAgentRole     String
  subAgentPlatform AppType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("main")
}

model MainTaskComment {
  id      String @id @default(cuid())
  content String

  taskId String
  task   MainTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("main")
}
